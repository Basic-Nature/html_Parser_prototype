# .env.template - Smart Elections Parser Configurations
# Loaded at runtime using python-dotenv for local/dev only.
# Azure App Settings override these values in production.
# Keep local .env PRIVATE and excluded from version control (see .gitignore).

# Table of Contents
# 1) Core Runtime
# 2) Database
# 3) Development & Access Controls
# 4) ML/NLP Training
# 5) Embeddings & Offline Models
# 6) Selenium NLP Integration
# 7) Browser Automation
# 8) CAPTCHA Handling
# 9) User-Agent Rotation
# 10) Parser Behavior
# 11) OCR/PDF Processing
# 12) Web App (Flask + SocketIO)
# 13) Notifications
# 14) Logging, Debugging, Output
# 15) Data Quality & Parallel Processing
# 16) Admin & Health Tasks
# 17) External Services
# 18) BallotLens Azure App Settings
# 19) CI/CD Configuration

# ============================================
# Core Runtime
# ============================================

# Indicates whether print output and input is set for webapp UI or CLI (optional forced)
# PROMPT_MODE=cli  # Options: cli, web, api

# The format with how output is sent (optional forced)
# LOG_FORMAT=plain  # Options: plain, json

# ============================================
# Database
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/smart_elections
CONTEXT_DB_PATH=webapp/parser/Context_Integration/context.db

# PostgreSQL database connection settings
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=warehouse_election_results
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SERVICE_NAME=postgresql-x64-17

# PostgreSQL connection pooling
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ============================================
# Development & Access Controls
# ============================================
DEV_MODE=true
ALLOW_DEV_NO_PRINCIPAL=true
ALLOW_AUTO_SESSION_REUSE=true
DEBUG_MODE=true
QA_REQUIRE_CERT_AUTH=false
DEV_ISOLATION_BYPASS_ENABLED=true
DEV_ISOLATION_BYPASS_IPS=127.0.0.1,::1

# ============================================
# ML/NLP Training
# ============================================

# Gate ML training data with manual review bot
# When TRUE, only user-verified QA panel corrections are used for training
# When FALSE, all data is used (less reliable for production)
REVIEW_WITH_MANUAL_BOT=true

# Enable HuggingFace BERT/RoBERTa fine-tuning
# Requires: pip install transformers datasets torch
# Set to FALSE in CI/CD to save time (uses spaCy only)
ENABLE_BERT_NER_FINETUNING=false

# BERT training hyperparameters
BERT_NER_EPOCHS=3
BERT_NER_BATCH_SIZE=16
BERT_NER_LEARNING_RATE=2e-5
BERT_NER_BASE_MODEL=dslim/bert-base-NER

# spaCy NER training (existing)
SPACY_NER_EPOCHS=30
SPACY_NER_BATCH_SIZE=8
SPACY_NER_MIN_DELTA=0.001
SPACY_NER_PATIENCE=3

# Sentence Transformer fine-tuning (existing)
SBERT_EPOCHS=4
SBERT_BATCH_SIZE=16

# Test dataset split
TEST_SPLIT_RATIO=0.2
MIN_TEST_SAMPLES=50

# Controls non-critical bot training tasks
SKIP_BOT_TASKS=true

# ============================================
# Embeddings & Offline Models
# ============================================

# If you pre-download a model locally, point to it here:
SENTENCE_TRANSFORMER_LOCAL_PATH=C:\models\all-MiniLM-L6-v2

# Offline mode (prevents network calls at runtime)
TRANSFORMERS_OFFLINE=1
HUGGINGFACE_HUB_OFFLINE=1

# Optional cache directory (used if not fully offline)
HUGGINGFACE_HUB_CACHE=C:\models\hf-cache
HF_HOME=C:\models\hf-cache

# ============================================
# Selenium NLP Integration
# ============================================

# Enable Selenium as strategic NLP training data collector
# See: docs/FEATURES/SELENIUM_NLP_INTEGRATION.md
ENABLE_SELENIUM_FALLBACK=true

# ============================================
# Browser Automation
# ============================================

# Options: chrome, msedge
BROWSER=msedge

# Run browser in headless mode? (true/false)
HEADLESS=false

# Time it takes for webpage to render before html_scan runs
SCAN_WAIT_SECONDS=7

# If set to true, auto-refresh browser on CAPTCHA screen (not always reliable)
AUTO_REFRESH_ON_CAPTCHA=false

# Time (in seconds) to wait before refreshing page after CAPTCHA is detected
CAPTCHA_REFRESH_DELAY=8

# Launch browser minimized if no CAPTCHA is detected
LAUNCH_MINIMIZED=true

# ============================================
# CAPTCHA Handling
# ============================================

# Toggle CAPTCHA detection and handling
CAPTCHA_DETECTION_ENABLED=true

# Allow dynamic exit from headless when CAPTCHA is detected (forces window to appear)
ELEVATE_ON_CAPTCHA=true

# Max time (in seconds) to wait for CAPTCHA resolution
CAPTCHA_TIMEOUT=120

# ============================================
# User-Agent Rotation
# ============================================

# Rotate through randomized user agents to reduce fingerprinting
USER_AGENT_ROTATION=true

# Optional: Provide your own comma-separated user agents (leave empty to use built-in pool)
CUSTOM_USER_AGENTS=

# ============================================
# Parser Behavior
# ============================================

# List of supported formats for parsing (HTML is the default)
SUPPORTED_FORMATS=.pdf,.csv,.json,.txt,.xlsx,.xls,.htm,.html

DISABLE_HTML_FALLBACK=0

# Automatically detect election format (PDF, CSV, JSON)
FORMAT_DETECTION_ENABLED=false

# Keywords to add to the header for output CSV files
CSV_HEADER_KEYWORDS=precinct,votes,candidate
PDF_HEADER_KEYWORDS=precinct,votes,candidate,early,absentee,provisional
JSON_HEADER_KEYWORDS=votes,candidate,early,absentee,provisional

# Force re-scan of all HTML before proceeding
FORCE_HTML_SCAN=true
FUZZY_MATCH_CUTOFF=0.7

# Enable multiprocessing for batch mode (experimental)
ENABLE_PARALLEL=false

# Limit contests shown (useful for debugging)
MAX_CONTESTS_DISPLAYED=15

# Adjust the threshold for toggling elements for clicking
TOGGLE_SCORE_THRESHOLD=1.0

# true for long (tidy) format (one row per candidate/precinct/method)
# false (or remove it) for wide format (one row per precinct, candidates as columns).
OUTPUT_LONG_FORMAT=false

# Toggle if timestamp shows on csv output
APPEND_TIMESTAMP=true
INCLUDE_TIMESTAMP_IN_FILENAME=true

# User prompt for segment labeling done in html_scanner.py
ENABLE_SEGMENT_LABEL_PROMPT=false

# ============================================
# OCR/PDF Processing
# ============================================

# Set to "false" to skip OCR fallback entirely
ENABLE_OCR=true

# Add to actual path for both (Windows)
POPPLER_PATH=C:\Program Files\poppler-24.08.0\Library\bin
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Attempts OCR scans the PDF format for clearer results
OCR_ATTEMPTS=3
OCR_CONFIDENCE_THRESHOLD=30
OCR_WARN_THRESHOLD=35
OCR_MAX_RETRIES=1
OCR_SHOW_HEATMAP=true
EXPORT_PARSED_TEXT=true

# ============================================
# Web App (Flask + SocketIO)
# ============================================

# How to set up a flask key
# python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your-very-long-random-string
FLASK_ENV=development
FLASK_DEBUG=false
FLASK_COOKIE_SECURE=False  # Set to True in production with HTTPS

# SocketIO configuration
SOCKETIO_ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
SOCKETIO_MESSAGE_QUEUE=  # Optional: Redis URL for multi-worker mode
SOCKETIO_MESSAGE_CHANNEL=socketio

# Heartbeat monitoring
HEARTBEAT_ENABLED=true

# ============================================
# Notifications
# ============================================

Notify_EMAILS=false  # Set to true to enable email notifications
# If enabled, set the following email configuration
NOTIFY_EMAIL=your@email.com
NOTIFY_EMAILS_ON_ERROR=false  # Set to true to receive emails on errors
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=your_smtp_from_address

# Slack Notifications
NOTIFY_SLACK=false  # Set to true to enable Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# SMS Notifications
NOTIFY_SMS=false  # Set to true to enable SMS notifications
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM=your_twilio_from_number
TWILIO_TO=your_twilio_to_number

# ============================================
# Logging, Debugging, Output
# ============================================

# Log verbosity (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable detailed mypy reports
MYPY_DETAILED_REPORT=false

# Save raw HTML snapshots when scanning
SAVE_HTML_DUMPS=false

# Save browser session screenshots on errors
SAVE_SCREENSHOTS_ON_ERROR=true

# Enable/disable saving CSVs at all
WRITE_CSV=true

# Timeout for page load or scanner stage
PAGE_LOAD_TIMEOUT=60

# Toggle .processed_urls caching directly
CACHE_PROCESSED=true
CACHE_RESET=false

# Limit how many URLs show up in the selection (useful in testing)
MAX_URLS_DISPLAYED=10

# Default file output folder override
OUTPUT_BASE_DIR=output

# ============================================
# Data Quality & Parallel Processing
# ============================================
ENABLE_QUALITY_LOGGING=true  # Log extraction quality metrics

# ============================================
# Admin & Health Tasks
# ============================================

# Enable health check and maintenance tasks (e.g., dataset promotion, OCR fine-tuning)
# Set to "true" to enable admin interface at /health_dashboard
ENABLE_HEALTH_TASKS=false

# Optional bearer token for health task endpoints (if set, all requests require token)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# HEALTH_TASK_TOKEN=your_secure_token_here

# ============================================
# External Services (Optional)
# ============================================

# Google Sheets (Smart Elections worklist + DB-lite)
GOOGLE_SHEETS_WORKLIST_ID=
GOOGLE_SHEETS_DB_LITE_ID=
GOOGLE_SHEETS_WORKLIST_OVERVIEW_SHEET=Overview

# Google Service Account Credentials - Option 1: Individual fields (recommended for Azure)
GOOGLE_SHEETS_SA_TYPE=service_account
GOOGLE_SHEETS_SA_PROJECT_ID=test-project-12
GOOGLE_SHEETS_SA_PRIVATE_KEY_ID=key123
GOOGLE_SHEETS_SA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\nTEST_KEY\\n-----END PRIVATE KEY-----\\n
GOOGLE_SHEETS_SA_CLIENT_EMAIL=test-client-email
GOOGLE_SHEETS_SA_CLIENT_ID=test-client-id
GOOGLE_SHEETS_SA_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_SHEETS_SA_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_SHEETS_SA_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_SHEETS_SA_CLIENT_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/test%40test-project.iam.gserviceaccount.com
GOOGLE_SHEETS_SA_UNIVERSE_DOMAIN=googleapis.com

# Google Service Account Credentials - Option 2: Complete JSON string (local dev fallback)
# GOOGLE_SHEETS_ELECTION_DB_LITE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}

# Google Cloud Storage (if using cloud storage for outputs)
GOOGLE_APPLICATION_CREDENTIALS=google_service_account.json

# ============================================
# BallotLens Azure App Settings
# ============================================
# Azure App Service uses App Settings as the source of truth.
# Keys already declared above are omitted to avoid duplication.

DEPLOY_ENV=localhost
POSTGRES_AUTH=user
POSTGRES_AAD_USER=ballotlens

# Azure App Service container/port settings
WEBSITES_PORT=8000
SCM_DO_BUILD_DURING_DEPLOYMENT=false

# Playwright/automation settings for Linux containers
PLAYWRIGHT_BROWSERS_PATH=0
HEADLESS_DEFAULT=True
ENABLE_FINGERPRINT_SESSION_RECOVERY=0

# OCR behavior overrides
ENABLE_OCR_FORCE=False

# App Service routing + CSP settings
DATA_API_URL=/api/ballotlens-database
CSP_MODE=STRICT  # Options: STRICT, RELAXED (RELAXED allows Bootstrap source maps from cdn.jsdelivr.net)
GUARDED_INGESTION_KEY=changeme
REQUIRE_CERT_FOR_MUTATIONS=true

# Content Security Policy (CSP) advanced configuration
# CSP_EXTRA_CONNECT can include CDNs for source maps (safe, optional)
# CSP_EXTRA_CONNECT=https://cdn.jsdelivr.net  # Allow Bootstrap source map fetching
# CSP_EXTRA_SCRIPT=  # Additional script-src origins (space-separated)
# ALLOW_STYLE_ATTR=true  # Allow inline Bootstrap styles (unsafe-inline for style-src-attr)

# Notes on CSP_MODE:
# - STRICT: Blocks all external CDN resources including source maps (production default)
# - RELAXED: Allows cdn.jsdelivr.net for Bootstrap source maps (safe for dev, optional for prod)
# - Source map violations are cosmetic; they don't affect functionality
# - Local vendor files (vendor/bootstrap.bundle.min.js) work in both modes

# Redirect logging controls
LOG_REDIRECT_HEADERS=True
LOG_REDIRECT_HEADERS_TTL_SEC=300

# ============================================
# CI/CD Configuration
# ============================================

# Skip long-running checks in CI pipeline
SKIP_BERT_FINETUNING_IN_CI=true
SKIP_WEB_CHECKS=false
SKIP_HEALTH_CHECKS=false
SKIP_TESTS=false

# GitHub Actions runner optimization
CI=false  # Set to 'true' in GitHub Actions