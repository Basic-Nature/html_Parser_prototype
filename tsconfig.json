{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "ES2021",
    "module": "commonjs",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "types": ["node", "jest"]
  },
  "include": [
    "scripts/**/*.js",
    "types/**/*.d.ts",
    "webapp/static/js/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "webapp/static/js/vendor/**",
    "webapp/static/js/vendor",
    "webapp/static/js/legacy/**"
  ]
}
