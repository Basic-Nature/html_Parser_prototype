# Consolidated .gitignore for html_Parser_prototype

# -------------------------
# Python artifacts & envs
# -------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pyc
*.egg-info/
.venv/
venv/
.venv-1/
env/
ENV/
pip-wheel-metadata/

# Test / cache
.pytest_cache/
.mypy_cache/
.tox/
.hypothesis/
.coverage
# -------------------------
# Editor / OS
# -------------------------
.vscode/
.idea/
.vs/
*.sublime-project
*.sublime-workspace
.code-workspace
.DS_Store
Thumbs.db
desktop.ini

# -------------------------
# Secrets / env
# -------------------------
.env
.env.*.local
secrets.*
*.secret

# Google API credentials (NEVER commit these)
google_service_account.json
*_service_account.json
credentials.json

# -------------------------
# Build / packaging
# -------------------------
build/
dist/
eggs/

# -------------------------
# Logs, runtime data, temporary outputs
# -------------------------
*.log
*.ndjson
*.idx
*.sqlite
*.sqlite3
*.db
*.gz
*.bak
*.tmp
*.swp
nohup.out
*.out
*debug.html
tools/tmp/
tools/debug_headless_output/
tools/prompt_smoke.html
!tools/tmp/.gitkeep
!tools/debug_headless_output/.gitkeep

# -------------------------
# Application runtime folders
# -------------------------
input/
output/
uploads/
tmp/
cache/
tmp_parser_pid.txt

# Keep committed fixtures directory (JSON indexes only — CSVs are regenerable, see scripts/convert_fec_csv_to_json.py)
!webapp/parser/fixtures/
!webapp/parser/fixtures/*.json

# Parser runtime state and telemetry
webapp/parser/Context_Integration/Context_Library/migration_state.json
webapp/parser/Context_Integration/Context_Library/empty_entries_watch.jsonl
webapp/parser/log/ml_usage_telemetry.jsonl

# Local diagnostic output
run_pdf_output.txt

# -------------------------
# Node / frontend
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.backup*.json
.dist/
.vite/
.storybook/
webpack-stats.json

# -------------------------
# Coverage / lint caches
# -------------------------
coverage/
.nyc_output/
.coverage
coverage.xml
htmlcov/
.eslintcache
.stylelintcache
.ruff_cache/
pytestdebug.log
hint-report/
tools/axe-report.json
tools/lh-report.json
tools/lh-screenshots/
tools/webhint-report.json
tools/screenshots/
tools/cluster_dom_mapping.json
tools/reports/
!tools/screenshots/.gitkeep
!tools/reports/.gitkeep
!tools/reports/annotated/.gitkeep

# -------------------------
# Browser drivers & automation
# -------------------------
msedge_driver.log
chromedriver.log
selenium-screenshots/
.playwright/
.ms-playwright/
webapp/ms-playwright/

# -------------------------
# Generated / runtime patterns
# -------------------------
# CSVs are local-only source files (handlers download from URLs, convert to JSON for fixtures)
*.csv
*.pdf
.output_cache.json
.processed_urls
fine_tuned_table_headers_tmp/
fine_tuned_spacy_ner_tmp/
.lock
cache/context_cache.json
# Cache and log directories contain runtime data (migrate to PostgreSQL based on confidence)
webapp/parser/Context_Integration/Context_Library/log/
webapp/parser/Context_Integration/Context_Library/cache/
webapp/parser/urls.txt.bak*
tools/debug_screenshots/
# -------------------------
# Jupyter / archives / misc
# -------------------------
.ipynb_checkpoints/
*.ipynb
*.tar.gz
*.zip
*.7z

# Local data/tests (exclude unless intentionally committed)
data/
/tests/
webapp/parser/tests/

# Temporary documentation (working notes, session drafts)
docs/temp/
docs/scratch/
docs/working/

# Dev notes / scripts

# Windows temp
%TEMP%/