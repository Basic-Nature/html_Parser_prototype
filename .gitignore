# Smart Elections Parser .gitignore (refactored)

# ----------------------------
# Python (source & environments)
# ----------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.egg-info/
.venv/
venv/
env/
.python-version
.env

# VCS/CI
.git
.github
.gitignore

# ----------------------------
# Node / JavaScript
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.backup*.json

# Build outputs (JS/TS)
dist/
build/
.next/
out/
.vite/
vite-cache/
.storybook/
.cache/
.tmp/
.temp/
webpack-stats.json

# Coverage / test / lint caches
coverage/
.nyc_output/
.coverage
coverage.xml
htmlcov/
.eslintcache
.stylelintcache
.pytest_cache/
.mypy_cache/
.ruff_cache/
pytestdebug.log
hint-report/ 

# ----------------------------
# Logs & transient debug
# ----------------------------
*.log
*.bak
*.tmp
*.swp
nohup.out
*.out
*debug.html

# ----------------------------
# Generated / runtime data
# ----------------------------
output/
input/
uploads/
*.csv
*.pdf
.output_cache.json
.processed_urls
fine_tuned_table_headers_tmp/
fine_tuned_spacy_ner_tmp/
.lock
cache/context_cache.json

# ----------------------------
# Browser drivers & automation
# ----------------------------
msedge_driver.log
chromedriver.log
selenium-screenshots/
.playwright/
.ms-playwright/
webapp/ms-playwright/

# ----------------------------
# IDE / Editor settings
# ----------------------------
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace

# ----------------------------
# Jupyter Notebooks (optional)
# ----------------------------
.ipynb_checkpoints/
*.ipynb

# ----------------------------
# System files
# ----------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----------------------------
# Azure / Functions local only
# ----------------------------
local.settings.json
.python_packages/

# ----------------------------
# Archives
# ----------------------------
*.tar.gz
*.zip
*.7z

# Local data/tests (exclude unless you truly need them in the image)
data/
tests/

# ----------------------------
# Dev configuration notes
# ----------------------------
# .env holds overrideable configs like:
# BROWSER=msedge|chrome
# HEADLESS=true|false
# CAPTCHA_DETECTION_ENABLED=true
# USER_AGENT_ROTATION=true
# OUTPUT_DIR=output
# Example final output path: ${OUTPUT_DIR}/${STATE}/${COUNTY}/${RACE}/results.csv