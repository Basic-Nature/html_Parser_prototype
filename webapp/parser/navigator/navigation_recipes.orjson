[
  {
    "id": "ny_rockland_default",
    "description": "Rockland County Enhanced Voting toggles",
    "match": {
      "state": "NY",
      "county": "Rockland",
      "url_contains": [
        "rocklandgov.com",
        "enhanced-voting"
      ],
      "dom_markers": [
        "View results by election district",
        "Vote Method"
      ]
    },
    "steps": [
      {
        "action": "wait_for_selector",
        "selector": "text=View results by election district",
        "timeout_ms": 12000
      },
      {
        "action": "click",
        "selector": "text=View results by election district",
        "wait_after_ms": 750
      },
      {
        "action": "click",
        "selector": "text=Vote Method",
        "wait_after_ms": 750
      },
      {
        "action": "parallel",
        "steps": [
          {
            "action": "wait",
            "timeout_ms": 1500
          },
          {
            "action": "autoscroll",
            "max_time_ms": 10000
          }
        ]
      },
      {
        "action": "scan_context",
        "store_key": "rockland_scan",
        "project": {
          "state": "state",
          "county": "county",
          "year": "year",
          "contests": "contests"
        }
      }
    ],
    "post_context": {
      "preferred_handler": "rockland",
      "navigation_profile": "rockland_default"
    }
  }
  ,
  {
    "id": "generic_precinct_panels",
    "description": "Toggle contest summary and precinct detail accordions",
    "match": {
      "states": ["PA", "MI", "GA"],
      "dom_markers": [
        "Contest Summary",
        "Precinct Detail"
      ]
    },
    "steps": [
      {
        "action": "wait_for_selector",
        "selector": "text=Contest Summary",
        "timeout_ms": 8000
      },
      {
        "action": "click",
        "selector": "text=Contest Summary",
        "wait_after_ms": 500
      },
      {
        "action": "click",
        "selector": "text=Precinct Detail",
        "wait_after_ms": 500
      },
      {
        "action": "parallel",
        "steps": [
          {"action": "wait", "timeout_ms": 600},
          {"action": "autoscroll", "max_time_ms": 6000}
        ]
      },
      {
        "action": "scan_context",
        "project": {
          "contests": "contests",
          "panels": "panels",
          "state": "state",
          "county": "county"
        }
      }
    ],
    "post_context": {
      "navigation_profile": "generic_precinct_panels"
    }
  }
  ,
  {
    "id": "generic_download_panel",
    "description": "Expose download drop-downs before handler routing",
    "match": {
      "url_contains": [
        "results",
        "election"
      ],
      "dom_markers": [
        "Download",
        "CSV"
      ]
    },
    "steps": [
      {
        "action": "wait_for_selector",
        "selector": "button[aria-controls*='download']",
        "timeout_ms": 7000
      },
      {
        "action": "click",
        "selector": "button[aria-controls*='download']",
        "wait_after_ms": 400
      },
      {
        "action": "parallel",
        "steps": [
          {"action": "wait", "timeout_ms": 400},
          {"action": "autoscroll", "max_time_ms": 4000}
        ]
      },
      {
        "action": "set_context",
        "values": {
          "download_panel_exposed": true
        }
      }
    ],
    "post_context": {
      "navigation_profile": "generic_download_panel"
    }
  }
]
