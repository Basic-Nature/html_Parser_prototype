{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Election Results Fixture Schema",
  "description": "Schema for election results fixture data organized by state, year, and contest",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "contest": {
        "type": "string",
        "description": "Contest name (e.g., 'President', 'US Senate', 'Governor')",
        "minLength": 1,
        "maxLength": 256
      },
      "candidates": {
        "type": "array",
        "description": "List of candidates in this contest",
        "minItems": 1,
        "maxItems": 10000,
        "items": {
          "type": "object",
          "required": ["name", "party", "votes"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Candidate name (canonical form)",
              "minLength": 1,
              "maxLength": 512
            },
            "party": {
              "type": "string",
              "description": "Party affiliation (DEM, REP, IND, LIB, GRN, etc.)",
              "minLength": 1,
              "maxLength": 64
            },
            "votes": {
              "type": "integer",
              "description": "Vote count",
              "minimum": 0,
              "maximum": 999999999
            },
            "percent": {
              "type": "number",
              "description": "Vote percentage (0.0-100.0)",
              "minimum": 0,
              "maximum": 100
            },
            "winner": {
              "type": "boolean",
              "description": "Whether candidate won contest",
              "default": false
            },
            "fec_id": {
              "type": "string",
              "description": "FEC candidate ID (optional, for audit)",
              "pattern": "^[PSH]\\d[A-Z]{2}\\d+$"
            }
          },
          "additionalProperties": false
        }
      },
      "source": {
        "type": "string",
        "description": "Source URL or reference",
        "format": "uri",
        "maxLength": 1024
      },
      "last_updated": {
        "type": "string",
        "description": "ISO 8601 timestamp of last update",
        "format": "date-time"
      },
      "confidence": {
        "type": "number",
        "description": "Data quality confidence score (0.0-1.0)",
        "minimum": 0,
        "maximum": 1
      },
      "metadata": {
        "type": "object",
        "description": "Flexible metadata (handler, extraction confidence, etc.)",
        "additionalProperties": true
      }
    },
    "required": ["contest", "candidates"],
    "additionalProperties": false
  }
}
