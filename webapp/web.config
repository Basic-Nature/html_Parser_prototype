<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <rewrite>
            <rules>
                <!-- Canonical Rule: Forces HTTPS and WWW instantly, securing the root trailing slash -->
                <rule name="Force WWW and HTTPS Global" stopProcessing="true">
                    <match url="(.*)" />
                    <conditions logicalGrouping="MatchAny">
                        <!-- Match if it is missing WWW -->
                        <add input="{HTTP_HOST}" pattern="^electionpulse\.org$" />
                        <!-- OR Match if it is using HTTP instead of HTTPS -->
                        <add input="{HTTPS}" pattern="^OFF$" />
                    </conditions>
                    <action type="Redirect" url="https://www.electionpulse.org/{R:1}" redirectType="Permanent" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
